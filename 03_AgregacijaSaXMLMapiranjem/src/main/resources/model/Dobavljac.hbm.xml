<?xml version="1.0"?>
<!DOCTYPE hibernate-mapping PUBLIC 
	"-//Hibernate/Hibernate Mapping DTD 3.0//EN"
	"http://hibernate.sourceforge.net/hibernate-mapping-3.0.dtd">
<hibernate-mapping 
	package="model">

	<class name="model.Dobavljac" table="Dobavljac" >
            
		<id name="dobavljacID" column="dobavljacID">
                    <generator class="assigned"></generator>
                </id>
                
                <property name="naziv" column="naziv"/>
                
                <property name="adresa" column="adresa"/>
                
                <set name="proizvodi" cascade="all" table="dobavlja">  
					<key column="dobavljacID"/>  
					<many-to-many column="proizvodID" class="Proizvod"/>  
				</set>  
		
	</class>
	
</hibernate-mapping>
